# ===================================================
# MADERAS LA CHOCA ERP/CRM - Variables de Entorno
# ===================================================

# Configuración del Entorno y Dominio
NODE_ENV=development
PORT=3000

# URL pública de la aplicación para enlaces web y redirecciones
# En desarrollo local: http://localhost:3000
# En producción (Vercel, VPS, Dominio propio): https://erp.maderaslachoca.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de Datos (Prisma ORM)
# Desarrollo local por defecto (SQLite autónomo, sin dependencias externas):
DATABASE_URL="file:./dev.db"

# Para despliegue en producción con PostgreSQL (Supabase, Neon, RDS, Railway, VPS):
# DATABASE_URL="postgresql://usuario:password@host:5432/maderas_la_choca?schema=public&sslmode=prefer"

# Para MySQL / MariaDB en VPS:
# DATABASE_URL="mysql://usuario:password@host:3306/maderas_la_choca"

# Autenticación y Sesiones
NEXTAUTH_SECRET="maderas-la-choca-super-secret-key-villahermosa-2026"
NEXTAUTH_URL=http://localhost:3000

# Datos de la Empresa (Membrete de Cotizaciones y Órdenes de Trabajo)
NEXT_PUBLIC_COMPANY_NAME="Maderas La Choca S.A. de C.V."
NEXT_PUBLIC_COMPANY_RFC="MLC210815AB3"
